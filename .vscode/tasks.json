{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run IVR backend (port 8002)",
            "type": "process",
            "command": "${workspaceFolder}\\backend\\venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "uvicorn",
                "app.main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8002"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\backend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
